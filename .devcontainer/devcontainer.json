{
  "name": "R.O.S MATE PHP",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y php-cli php-sqlite3",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "R.O.S MATE",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  }
}
